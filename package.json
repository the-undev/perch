{
  "name": "perch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gather": "node src/cli/gather.ts",
    "aggregate": "node src/cli/aggregate.ts",
    "scan": "pnpm gather && pnpm aggregate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vitest": "^5.0.5"
  }
}
