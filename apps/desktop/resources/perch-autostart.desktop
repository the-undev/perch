# Starts perch at login with the window hidden and its icon in the tray. systemd runs XDG autostart
# entries as generated user units, this one app-perch@autostart.service.
# Link into ~/.config/autostart/ as perch.desktop, see the README.
[Desktop Entry]
Type=Application
Name=perch
Comment=Birds on wires: the state of everything in progress on this machine
Exec=perch --hidden
Icon=perch
Terminal=false
