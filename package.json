{
  "name": "perch",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gather": "node packages/core/src/cli/gather.ts",
    "aggregate": "node packages/core/src/cli/aggregate.ts",
    "scan": "pnpm gather && pnpm aggregate",
    "dev": "pnpm --filter @perch/desktop dev",
    "design": "pnpm --filter @perch/design dev",
    "dist": "pnpm --filter @perch/desktop dist",
    "icons": "pnpm --filter @perch/desktop icons",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "release": "node apps/desktop/scripts/release.ts",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript5": "npm:typescript@5.9.3"
  }
}
